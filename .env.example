# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Optional overrides
# Model used for structured JSON generation. Must support strict structured
# outputs on Groq — currently openai/gpt-oss-20b and openai/gpt-oss-120b.
SPORTS_AGENT_MODEL=openai/gpt-oss-20b
# Model used for the live web-research turn. groq/compound and
# groq/compound-mini run automatic, built-in web search with no tool schema.
# compound-mini is the default: lower latency, single search per request, and
# fits inside lower-tier per-minute token limits where full compound 413s.
SPORTS_AGENT_RESEARCH_MODEL=groq/compound-mini
# Sampling temperature (0-2, lower = more deterministic)
SPORTS_AGENT_TEMPERATURE=0.6
# Reasoning effort for the openai/gpt-oss generation model: low | medium | high.
# gpt-oss models spend completion tokens on hidden reasoning before the final
# JSON — "low" leaves enough of the token budget for the actual answer.
SPORTS_AGENT_REASONING_EFFORT=low
# Where ChromaDB persists its index
CHROMA_DIR=app/data/chroma
# Where the freshness/dedup history is stored
HISTORY_DB=app/data/history.sqlite3
# Similarity above which two questions are considered duplicates (0-1)
DEDUPE_THRESHOLD=0.55
# Set to 0 to disable live web search (vector DB grounding only)
ENABLE_WEB_SEARCH=1
# Max simultaneous generation calls per batch. Lower tiers enforce a small
# per-minute token budget shared across concurrent requests; raise this on a
# higher tier for faster batches.
SPORTS_AGENT_MAX_CONCURRENCY=2
